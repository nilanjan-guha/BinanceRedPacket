# Telegram API credentials (obtain from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Optional: List of target Telegram channel usernames or IDs separated by commas.
# If left empty, the bot will monitor all joined chats/channels.
# Example: TARGET_CHANNELS=binance_box_channel,crypto_giveaways
TARGET_CHANNELS=

# Playwright Browser Configuration
# Path where Chrome user profile will be persisted to keep you logged in to Binance
CHROME_PROFILE_DIR=./binance_browser_profile

# Run browser in headless mode (False recommended so you can log in, view 2FA & see popups)
HEADLESS=False

# Binance Crypto Box URL
BINANCE_CRYPTO_BOX_URL=https://www.binance.com/en/my/wallet/account/payment/cryptobox

# Cooldown between submissions in seconds (to avoid rate limits on incorrect codes)
CLAIM_COOLDOWN_SECONDS=2

